// Cloudflare Workers deploy of the download site (docs/) plus the email signup API (worker/).
// Committed so the build does not depend on wrangler's auto-setup prompts.
{
  "name": "gamepad",
  "compatibility_date": "2026-10-23",
  "main": "worker/index.js",
  "assets": { "directory": "docs" },
  "workers_dev": true,
  "preview_urls": false
  // Email signup: create a KV namespace in the Cloudflare dashboard, then add
  // "kv_namespaces": [{ "binding": "EMAILS", "id": "<namespace id>" }]
  // Until then /api/subscribe answers "not switched on yet".
}
